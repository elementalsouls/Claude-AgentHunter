#!/usr/bin/env sh
# Block a commit that would introduce a leaked CTF flag, a /Users|/home username path,
# or a credential token. Scans only the STAGED files via scripts/scan_secrets.py.
# Install with scripts/install-hooks.sh. Bypass once (not recommended): git commit --no-verify
root="$(git rev-parse --show-toplevel)" || exit 1
cd "$root" || exit 1

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

if git diff --cached --name-only --diff-filter=ACM -z | xargs -0 python3 scripts/scan_secrets.py --; then
  exit 0
fi

echo "pre-commit: scan_secrets found a potential leak — commit blocked." >&2
echo "            fix the finding above, or bypass once with:  git commit --no-verify" >&2
exit 1
